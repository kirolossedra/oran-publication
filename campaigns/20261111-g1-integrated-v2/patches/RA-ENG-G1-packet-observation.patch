+class IbOranPacketObservationHeader : public Header
+{
+  public:
+    static TypeId GetTypeId()
+    {
+        static TypeId tid = TypeId("ns3::IbOranPacketObservationHeader")
+                                .SetParent<Header>().SetGroupName("IbOran")
+                                .AddConstructor<IbOranPacketObservationHeader>();
+        return tid;
+    }
+    TypeId GetInstanceTypeId() const override { return GetTypeId(); }
+    uint32_t GetSerializedSize() const override { return 18; }
+    void Serialize(Buffer::Iterator i) const override
+    {
+        i.WriteHtonU32(m_sequence); i.WriteHtonU64(m_txNs); i.WriteHtonU16(m_rnti);
+        i.WriteHtonU16(m_ue); i.WriteHtonU16(m_direction);
+    }
+    uint32_t Deserialize(Buffer::Iterator i) override
+    {
+        m_sequence = i.ReadNtohU32(); m_txNs = i.ReadNtohU64(); m_rnti = i.ReadNtohU16();
+        m_ue = i.ReadNtohU16(); m_direction = i.ReadNtohU16();
+        return GetSerializedSize();
+    }
+    void Print(std::ostream& os) const override { os << m_sequence << '@' << m_txNs; }
+    void Set(uint32_t seq, uint64_t time, uint16_t rnti, uint16_t ue, uint16_t direction)
+    { m_sequence = seq; m_txNs = time; m_rnti = rnti; m_ue = ue; m_direction = direction; }
+    uint32_t Sequence() const { return m_sequence; }
+    uint64_t TxNs() const { return m_txNs; }
+    uint16_t Rnti() const { return m_rnti; }
+    uint16_t Ue() const { return m_ue; }
+    uint16_t Direction() const { return m_direction; }
+  private:
+    uint32_t m_sequence{0}; uint64_t m_txNs{0}; uint16_t m_rnti{0};
+    uint16_t m_ue{0}; uint16_t m_direction{0};
+};
+NS_OBJECT_ENSURE_REGISTERED(IbOranPacketObservationHeader);
+
+void RecordPacketEvent(const char* event, const IbOranPacketObservationHeader& tag, uint32_t bytes)
+{
+    const char* root = std::getenv("IBORAN_RUN_DIR");
+    if (!root) return;
+    static bool initialized = false;
+    std::ofstream out(std::string(root) + "/logs/packet-events.csv", std::ios::app);
+    if (!initialized)
+    {
+        out << "event,time_ns,ue_index,rnti,direction,sequence,tx_time_ns,bytes\n";
+        initialized = true;
+    }
+    out << event << ',' << Simulator::Now().GetNanoSeconds() << ',' << tag.Ue() << ','
+        << tag.Rnti() << ',' << tag.Direction() << ',' << tag.Sequence() << ','
+        << tag.TxNs() << ',' << bytes << '\n';
+}
+}
