+{
+void
+WriteFronthaulStateRow(NodeContainer xnbNodes,
+                       NodeContainer ueNodes,
+                       NetDeviceContainer ueDevices,
+                       Ptr<ChannelConditionModel> conditionModel,
+                       double tracePeriodSeconds,
+                       double simulationEndSeconds)
+{
+    const double time = Simulator::Now().GetSeconds();
+    const auto gnb = xnbNodes.Get(0)->GetObject<MobilityModel>();
+    const auto gnbPosition = gnb->GetPosition();
+    for (uint32_t i = 0; i < ueNodes.GetN(); ++i)
+    {
+        const auto ue = ueNodes.Get(i)->GetObject<MobilityModel>();
+        const auto position = ue->GetPosition();
+        const auto state = conditionModel->GetChannelCondition(gnb, ue);
+        const auto ueDevice = DynamicCast<NrUeNetDevice>(ueDevices.Get(i));
+        std::cout << std::setprecision(12) << "RADIO_MOBILITY_TRACE," << time << ',' << i << ','
+                  << ueNodes.Get(i)->GetId() << ',' << xnbNodes.Get(0)->GetId() << ','
+                  << (ueDevice ? ueDevice->GetRrc()->GetRnti() : 0) << ',' << gnbPosition.x << ','
+                  << gnbPosition.y << ',' << gnbPosition.z << ',' << position.x << ','
+                  << position.y << ',' << position.z << ','
+                  << (state->IsLos() ? "LOS" : (state->IsNlos() ? "NLOS" : "NLOSv")) << '\n';
+    }
+    if (time + tracePeriodSeconds <= simulationEndSeconds)
+    {
+        Simulator::Schedule(Seconds(tracePeriodSeconds),
+                            &WriteFronthaulStateRow,
+                            xnbNodes,
+                            ueNodes,
+                            ueDevices,
+                            conditionModel,
+                            tracePeriodSeconds,
+                            simulationEndSeconds);
+    }
+}
