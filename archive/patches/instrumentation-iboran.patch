+namespace
+{
+struct UdpFlowCounters
+{
+    uint64_t txPackets{0};
+    uint64_t txBytes{0};
+    uint64_t rxPackets{0};
+    uint64_t rxBytes{0};
+};
+std::map<uint16_t, UdpFlowCounters> g_udpFlowCounters;
+
+void
+CountUdpTx(Ptr<const Packet> packet, const Address&, const Address& peer)
+{
+    const uint16_t port = InetSocketAddress::ConvertFrom(peer).GetPort();
+    auto& counters = g_udpFlowCounters[port];
+    ++counters.txPackets;
+    counters.txBytes += packet->GetSize();
+}
+
+uint64_t
+GetPayloadSize(const Ptr<const Packet>& packet)
+{
+    Ptr<Packet> copy = packet->Copy();
+    SeqTsSizeHeader header;
+    copy->RemoveHeader(header);
+    return copy->GetSize();
+}
+
+void
+CountUdpTxWithHeader(Ptr<const Packet> packet, const Address&, const Address& peer)
+{
+    const uint16_t port = InetSocketAddress::ConvertFrom(peer).GetPort();
+    auto& counters = g_udpFlowCounters[port];
+    ++counters.txPackets;
+    counters.txBytes += GetPayloadSize(packet);
+}
+
+void
+CountUdpRxWithHeader(Ptr<const Packet> packet, const Address&, const Address& local)
+{
+    const uint16_t port = InetSocketAddress::ConvertFrom(local).GetPort();
+    auto& counters = g_udpFlowCounters[port];
+    ++counters.rxPackets;
+    counters.rxBytes += GetPayloadSize(packet);
+}
+
+void
+CountUdpRx(Ptr<const Packet> packet, const Address&, const Address& local)
+{
+    const uint16_t port = InetSocketAddress::ConvertFrom(local).GetPort();
+    auto& counters = g_udpFlowCounters[port];
+    ++counters.rxPackets;
+    counters.rxBytes += packet->GetSize();
+}
+
+void
+TraceUdpPacketTx(Ptr<const Packet>,
+                 const Address& from,
+                 const Address& to,
+                 const SeqTsSizeHeader& header)
+{
+    const auto source = InetSocketAddress::ConvertFrom(from);
+    const auto destination = InetSocketAddress::ConvertFrom(to);
+    const uint64_t payloadBytes = header.GetSize() - header.GetSerializedSize();
+    std::cout << "PACKET_TX," << Simulator::Now().GetNanoSeconds() << ',' << header.GetSeq() << ','
+              << header.GetTs().GetNanoSeconds() << ',' << payloadBytes << ',' << source.GetIpv4()
+              << ',' << source.GetPort() << ',' << destination.GetIpv4() << ','
+              << destination.GetPort() << '\n';
+}
+
+void
+TraceUdpPacketRx(Ptr<const Packet>,
+                 const Address& from,
+                 const Address& local,
+                 const SeqTsSizeHeader& header)
+{
+    const auto source = InetSocketAddress::ConvertFrom(from);
+    const auto destination = InetSocketAddress::ConvertFrom(local);
+    const uint64_t payloadBytes = header.GetSize() - header.GetSerializedSize();
+    std::cout << "PACKET_RX," << Simulator::Now().GetNanoSeconds() << ',' << header.GetSeq() << ','
+              << header.GetTs().GetNanoSeconds() << ',' << payloadBytes << ',' << source.GetIpv4()
+              << ',' << source.GetPort() << ',' << destination.GetIpv4() << ','
+              << destination.GetPort() << '\n';
+}
+
+void
+PrintUdpFlowResult(uint32_t ueIndex,
+                   const std::string& direction,
+                   Ipv4Address ueAddress,
+                   Ipv4Address remoteAddress,
+                   uint16_t port,
+                   Ptr<NrUeNetDevice> ueDevice)
+{
+    const auto& counters = g_udpFlowCounters[port];
+    const uint16_t rnti = ueDevice ? ueDevice->GetRrc()->GetRnti() : 0;
+    std::cout << "UE_TRAFFIC_RESULT," << direction << ',' << ueIndex << ',' << ueAddress << ','
+              << rnti << ',' << remoteAddress << ',' << port << ',' << counters.txPackets << ','
+              << counters.txBytes << ',' << counters.rxPackets << ',' << counters.rxBytes << '\n';
+}
