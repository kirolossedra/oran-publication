+                 "gnb_x_m,gnb_y_m,gnb_z_m,ue_x_m,ue_y_m,ue_z_m,condition\n";
+    Simulator::Schedule(Seconds(0),
+                        &WriteFronthaulStateRow,
+                        xnbNodes,
+                        ueNodes,
+                        ueDevices,
+                        conditionModel,
+                        tracePeriodSeconds,
+                        simulationEndSeconds);
+}
