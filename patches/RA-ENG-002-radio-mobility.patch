diff --git a/model/iboran_ran_environment/iboran-ran-common.cc b/model/iboran_ran_environment/iboran-ran-common.cc
index ef81b97..b49a53e 100644
--- a/model/iboran_ran_environment/iboran-ran-common.cc
+++ b/model/iboran_ran_environment/iboran-ran-common.cc
@@ -311,20 +311,54 @@ SetupFronthaulMobility(const CommonRanParams& commonParams,
-    // UEs with random walk mobility
-    MobilityHelper ueMobility;
-    ueMobility.SetMobilityModel(
-        "ns3::RandomWalk2dMobilityModel",
-        "Bounds",
-        RectangleValue(Rectangle(0, commonParams.simAreaLength, 0, commonParams.simAreaLength)),
-        "Speed",
-        StringValue("ns3::ConstantRandomVariable[Constant=0.83]"), // ~3 km/h
-        "Mode",
-        StringValue("Distance"),
-        "Distance",
-        DoubleValue(100.0) // change direction every 100 m
-    );
-    ueMobility.Install(ueNodes);
-
-    // Set initial random positions for UEs
-    Ptr<UniformRandomVariable> randPos = CreateObject<UniformRandomVariable>();
-    randPos->SetAttribute("Min", DoubleValue(0.0));
-    randPos->SetAttribute("Max", DoubleValue(commonParams.simAreaLength));
-    for (uint32_t i = 0; i < commonParams.ueNum; i++)
+    if (commonParams.mobilityMode == "RandomWalk")
+    {
+        // Retain the pinned upstream RandomWalk model and randomized placement.
+        MobilityHelper ueMobility;
+        ueMobility.SetMobilityModel(
+            "ns3::RandomWalk2dMobilityModel",
+            "Bounds",
+            RectangleValue(Rectangle(0, commonParams.simAreaLength, 0, commonParams.simAreaLength)),
+            "Speed",
+            StringValue("ns3::ConstantRandomVariable[Constant=0.83]"), // ~3 km/h
+            "Mode",
+            StringValue("Distance"),
+            "Distance",
+            DoubleValue(100.0));
+        ueMobility.Install(ueNodes);
+
+        Ptr<UniformRandomVariable> randPos = CreateObject<UniformRandomVariable>();
+        randPos->SetAttribute("Min", DoubleValue(0.0));
+        randPos->SetAttribute("Max", DoubleValue(commonParams.simAreaLength));
+        for (uint32_t i = 0; i < ueNodes.GetN(); i++)
+        {
+            ueNodes.Get(i)->GetObject<MobilityModel>()->SetPosition(
+                Vector(randPos->GetValue(), randPos->GetValue(), 1.5));
+        }
+    }
+    else if (commonParams.mobilityMode == "Fixed" ||
+             commonParams.mobilityMode == "ControlledMoving")
+    {
+        NS_ABORT_MSG_IF(commonParams.ueNum != 6,
+                        commonParams.mobilityMode << " validation geometry requires exactly 6 UEs");
+        NS_ABORT_MSG_IF(commonParams.controlledMobilitySpeedMps <= 0.0,
+                        "controlledMobilitySpeedMps must be positive");
+        MobilityHelper ueMobility;
+        ueMobility.SetMobilityModel(commonParams.mobilityMode == "Fixed"
+                                        ? "ns3::ConstantPositionMobilityModel"
+                                        : "ns3::ConstantVelocityMobilityModel");
+        ueMobility.Install(ueNodes);
+        for (uint32_t i = 0; i < ueNodes.GetN(); i++)
+        {
+            // Same deterministic 2x3 grid for both paired mobility arms.
+            const double x = commonParams.simAreaLength * 0.5 +
+                             (static_cast<int>(i % 3) - 1) * 10.0;
+            const double y = commonParams.simAreaLength * 0.5 +
+                             (static_cast<int>(i / 3) == 0 ? -5.0 : 5.0);
+            Ptr<MobilityModel> model = ueNodes.Get(i)->GetObject<MobilityModel>();
+            model->SetPosition(Vector(x, y, 1.5));
+            if (commonParams.mobilityMode == "ControlledMoving")
+            {
+                ueNodes.Get(i)->GetObject<ConstantVelocityMobilityModel>()->SetVelocity(
+                    Vector(commonParams.controlledMobilitySpeedMps, 0.0, 0.0));
+            }
+        }
+    }
+    else
@@ -332,5 +366,2 @@ SetupFronthaulMobility(const CommonRanParams& commonParams,
-        double xPos = randPos->GetValue();
-        double yPos = randPos->GetValue();
-        ueNodes.Get(i)->GetObject<MobilityModel>()->SetPosition(
-            Vector(xPos, yPos, 1.5) // 1.5 m user height
-        );
+        NS_ABORT_MSG("Unknown mobilityMode '" << commonParams.mobilityMode
+                                                << "' (expected RandomWalk, Fixed, ControlledMoving)");
@@ -353,0 +385,62 @@ SetupFronthaulMobility(const CommonRanParams& commonParams,
+namespace
+{
+void
+WriteFronthaulStateRow(NodeContainer xnbNodes,
+                       NodeContainer ueNodes,
+                       NetDeviceContainer ueDevices,
+                       Ptr<ChannelConditionModel> conditionModel,
+                       double tracePeriodSeconds,
+                       double simulationEndSeconds)
+{
+    const double time = Simulator::Now().GetSeconds();
+    const auto gnb = xnbNodes.Get(0)->GetObject<MobilityModel>();
+    const auto gnbPosition = gnb->GetPosition();
+    for (uint32_t i = 0; i < ueNodes.GetN(); ++i)
+    {
+        const auto ue = ueNodes.Get(i)->GetObject<MobilityModel>();
+        const auto position = ue->GetPosition();
+        const auto state = conditionModel->GetChannelCondition(gnb, ue);
+        const auto ueDevice = DynamicCast<NrUeNetDevice>(ueDevices.Get(i));
+        std::cout << std::setprecision(12) << "RADIO_MOBILITY_TRACE," << time << ',' << i << ','
+                  << ueNodes.Get(i)->GetId() << ',' << xnbNodes.Get(0)->GetId() << ','
+                  << (ueDevice ? ueDevice->GetRrc()->GetRnti() : 0) << ',' << gnbPosition.x << ','
+                  << gnbPosition.y << ',' << gnbPosition.z << ',' << position.x << ','
+                  << position.y << ',' << position.z << ','
+                  << (state->IsLos() ? "LOS" : (state->IsNlos() ? "NLOS" : "NLOSv")) << '\n';
+    }
+    if (time + tracePeriodSeconds <= simulationEndSeconds)
+    {
+        Simulator::Schedule(Seconds(tracePeriodSeconds),
+                            &WriteFronthaulStateRow,
+                            xnbNodes,
+                            ueNodes,
+                            ueDevices,
+                            conditionModel,
+                            tracePeriodSeconds,
+                            simulationEndSeconds);
+    }
+}
+} // namespace
+
+void
+ScheduleFronthaulStateTrace(const NodeContainer& xnbNodes,
+                            const NodeContainer& ueNodes,
+                            const NetDeviceContainer& ueDevices,
+                            Ptr<ChannelConditionModel> conditionModel,
+                            double tracePeriodSeconds,
+                            double simulationEndSeconds)
+{
+    NS_ABORT_MSG_IF(!conditionModel, "Cannot trace a null channel condition model");
+    NS_ABORT_MSG_IF(tracePeriodSeconds <= 0.0, "Trace period must be positive");
+    std::cout << "RADIO_MOBILITY_TRACE,time_s,ue_index,ue_node_id,gnb_node_id,rnti,"
+                 "gnb_x_m,gnb_y_m,gnb_z_m,ue_x_m,ue_y_m,ue_z_m,condition\n";
+    Simulator::Schedule(Seconds(0),
+                        &WriteFronthaulStateRow,
+                        xnbNodes,
+                        ueNodes,
+                        ueDevices,
+                        conditionModel,
+                        tracePeriodSeconds,
+                        simulationEndSeconds);
+}
+
