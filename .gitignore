# Local pinned ns-3, NR, ns3-ai and ib-ORAN checkouts/builds are untracked.
# Tracked research code lives under simulator/overrides/iboran/model/.
# This is intentional: ns-3 and ib-ORAN are separate upstream Git projects.
/simulator/*
!/simulator/README.md
!/simulator/DEPENDENCIES.md
!/simulator/overrides/

# Preserve only reviewed small calibration outputs in Git.
/results/*
!/results/README.md
!/results/calibration/

# Never commit virtual environments, generated run data, credentials or secrets.
/build/
**/build/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.pcap*
*.tr
*.trace
*.sqlite*
*.db
*.parquet
*.npy
*.npz
*.h5
*.mat
*.o
*.a
*.so*
*.out
*.core
.env
.env.*
!.env.example
.aws/
.ssh/
*.pem
*.key
*credentials*
*token*
*.tmp
*.swp
*~
.DS_Store
